{
  "permissions": {
    "allow": [
      "Edit(~/.claude/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git grep:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Edit(**/.env)",
      "Edit(**/secrets.json)",
      "Read(**/.env)",
      "Read(**/*.keys)",
      "Read(**/secrets.json)",
      "Read(**/*Secrets*)",
      "Read(**/.DS_Store)",
      "Read(**/*.log)",
      "Read(.idea/**)",
      "Read(.vscode/**)"
    ]
  }
}
