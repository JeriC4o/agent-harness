{
  "permissions": {
    "allow": [
      "Edit(~/.claude/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git grep:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ],
    "ask": [
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add -u*)",
      "Bash(git add --update*)",
      "Bash(git add . *)",
      "Bash(git add :/ *)",
      "Bash(git add * -A*)",
      "Bash(git add * --all*)",
      "Bash(git add * -u*)",
      "Bash(git add * --update*)",
      "Bash(git add * .)",
      "Bash(git add * . *)",
      "Bash(git add * :/)",
      "Bash(git add * :/ *)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(git commit . *)",
      "Bash(git commit :/ *)",
      "Bash(git commit * -a*)",
      "Bash(git commit * --all*)",
      "Bash(git commit * .)",
      "Bash(git commit * . *)",
      "Bash(git commit * :/)",
      "Bash(git commit * :/ *)"
    ],
    "deny": [
      "Edit(**/.env)",
      "Edit(**/secrets.json)",
      "Read(**/.env)",
      "Read(**/*.keys)",
      "Read(**/secrets.json)",
      "Read(**/*Secrets*)",
      "Read(**/.DS_Store)",
      "Read(**/*.log)",
      "Read(.idea/**)",
      "Read(.vscode/**)"
    ]
  }
}
