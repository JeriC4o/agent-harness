{
  "permissions": {
    "allow": [
      "Edit(~/.claude/**)",
      "Read(~/.claude/plugins/cache/*/harness/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git grep:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(wc:*)",
      "Bash(awk:*)",
      "Bash(basename:*)",
      "Bash(realpath:*)",
      "Bash(stat:*)",
      "Bash(sleep:*)"
    ],
    "deny": [
      "Edit(**/.env)",
      "Edit(**/secrets.json)",
      "Read(**/.env)",
      "Read(**/*.keys)",
      "Read(**/secrets.json)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/*Keys*.swift)",
      "Read(**/*Secrets*)",
      "Read(**/.DS_Store)",
      "Read(**/*.log)",
      "Read(.idea/**)",
      "Read(.vscode/**)",
      "Read(out/**)",
      "Read(build/**)",
      "Read(target/**)",
      "Read(node_modules/**)"
    ]
  }
}
